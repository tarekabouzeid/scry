# A ready-to-run .env for the local Keycloak demo — matches
# infra/docker/keycloak/realm-export.json exactly. Copy this to .env
# (instead of .env.example) when using the Keycloak overlay:
#
#   cp .env.keycloak.example .env
#   docker compose -f infra/docker/docker-compose.yml \
#                   -f infra/docker/docker-compose.keycloak.yml up -d
#
# Demo logins and the story behind the seeded data: docs/demo.md
#   alice / alice123 (admin) · bob / bob123 · sam / sam123 · dan / dan123
#   priya / priya123 · lena / lena123 · omar / omar123
#   carol / carol123 (no team yet — onboarding)

# --- Postgres (pgvector) ---
POSTGRES_USER=scry
POSTGRES_PASSWORD=scry
POSTGRES_DB=scry
POSTGRES_PORT=5432
DATABASE_URL=postgres://scry:scry@localhost:5432/scry

# --- Valkey / Redis (queues, rate limits, caches) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3001
NODE_ENV=development

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# Behind a reverse proxy, set how many hops to trust (e.g. 1) so rate limits
# see the client IP instead of the proxy's.
# TRUST_PROXY=1

# --- Auth (OIDC) — the local Keycloak demo realm ---
OIDC_ISSUER_URL=http://localhost:8080/realms/scry
OIDC_CLIENT_ID=scry-web
OIDC_CLIENT_SECRET=scry-dev-client-secret
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
# Dev-only value — generate a real one for anything beyond this demo:
# `openssl rand -hex 32`
SESSION_SECRET=dev-only-not-for-production-0123456789abcdef

# --- AI / LLM ---
# Normally configured in the app: Admin → AI & models (endpoint, auth — API
# key or JWT — and a model per role). These variables are only a fallback,
# used while no admin has saved settings there. For the demo, leave them
# blank: signing in as alice and connecting the demo LLM is part of the tour
# (docs/demo.md).
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=
# Size of the vectors the embedding model returns (default 1536).
LLM_EMBEDDING_DIMENSIONS=
# Encrypts the AI credentials an admin saves (API keys, client secrets,
# signing keys). Defaults to a key derived from SESSION_SECRET; set it to
# rotate SESSION_SECRET without having to re-enter them. `openssl rand -hex 32`
SETTINGS_ENCRYPTION_KEY=
# Optional: only let AI traffic (model endpoint, OAuth2 token URL) go to these
# hosts, e.g. "litellm:4000,*.openai.azure.com". Unset = any host. Set here,
# not in the UI, so an admin account can't widen it.
LLM_ALLOWED_HOSTS=

# --- Matching thresholds (fallbacks too — admins tune them in AI & models) ---
AGENT_STRONG_MATCH_THRESHOLD=0.85
AGENT_WEAK_MATCH_THRESHOLD=0.65

# --- Admins ---
# Who is made an admin when they sign in, comma-separated. Nobody else is,
# so set this before the first sign-in. (A listed person is promoted again
# only if the install has no admin left.)
INITIAL_ADMIN_EMAILS=alice@example.com

# --- Teams ---
# The org units and countries a team can be filed under, comma-separated.
# People choose from these when they create a team, and the brief groups by
# org unit. Defaults (when blank) match the demo.
ORG_UNITS=Engineering,Marketing,Operations,Product,Security
COUNTRIES=DE,FR,NL,UK,US

# --- Notifications: weekly digest of new/changed initiatives ---
NOTIFICATIONS_CRON=0 9 * * 1
NOTIFICATIONS_CHANNEL=
NOTIFICATIONS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=scry@localhost
NOTIFICATIONS_EMAIL_TO=
