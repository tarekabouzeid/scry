# Copy to .env and adjust. Used by both the docker-compose infra and the
# api app running natively via `pnpm dev`.

# --- Postgres (pgvector) ---
POSTGRES_USER=scry
POSTGRES_PASSWORD=scry
POSTGRES_DB=scry
POSTGRES_PORT=5432
DATABASE_URL=postgres://scry:scry@localhost:5432/scry

# --- Valkey / Redis (queues, rate limits, caches) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Background jobs each api replica runs at once. Embedding jobs hold up to
# 50 initiatives (one model request); TL;DRs are also capped at 5 a second.
# EMBEDDING_CONCURRENCY=8
# TLDR_CONCURRENCY=4
# Texts per embedding request (default 50). Lower it if your gateway caps
# batches (older Azure OpenAI deployments take 16).
# EMBEDDING_BATCH_SIZE=50
# Memory Postgres gets to build the vector index (on start, or after the
# embedding model changes). About 1GB covers a million initiatives.
# VECTOR_INDEX_MEMORY=1GB

# --- API ---
API_PORT=3001
NODE_ENV=development

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# Behind a reverse proxy, set how many hops to trust (e.g. 1) so rate limits
# see the client IP instead of the proxy's.
# TRUST_PROXY=1

# --- Auth (OIDC) ---
# Any standard OIDC provider: Keycloak, Okta, Azure AD, Google Workspace, etc.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
# Random 32+ byte secret used to sign session cookies, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# --- AI tools (MCP) ---
# The api's public address as AI tools reach it (for OAuth and /mcp).
# Defaults to NEXT_PUBLIC_API_URL, then the origin of OIDC_REDIRECT_URI.
# API_PUBLIC_URL=https://api.scry.example.com
# How long every MCP tool call is kept in the usage log (days).
# MCP_LOG_RETENTION_DAYS=90

# --- AI / LLM ---
# Normally configured in the app: Admin → AI & models (endpoint, auth — API
# key or JWT — and a model per role). These variables are only a fallback,
# used while no admin has saved settings there.
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=
# Size of the vectors the embedding model returns (default 1536).
LLM_EMBEDDING_DIMENSIONS=
# Text put before searches and before initiatives, for models trained with
# prefixes (EmbeddingGemma: "task: search result | query: " and
# "title: none | text: "). Leave empty for OpenAI models.
# LLM_EMBEDDING_QUERY_PREFIX=
# LLM_EMBEDDING_DOCUMENT_PREFIX=
# Encrypts the AI credentials an admin saves (API keys, client secrets,
# signing keys). Defaults to a key derived from SESSION_SECRET; set it to
# rotate SESSION_SECRET without having to re-enter them. `openssl rand -hex 32`
SETTINGS_ENCRYPTION_KEY=
# Optional: only let AI traffic (model endpoint, OAuth2 token URL) go to these
# hosts, e.g. "litellm:4000,*.openai.azure.com". Unset = any host. Set here,
# not in the UI, so an admin account can't widen it.
LLM_ALLOWED_HOSTS=

# --- Matching thresholds (fallbacks too — admins tune them in AI & models) ---
AGENT_STRONG_MATCH_THRESHOLD=0.85
AGENT_WEAK_MATCH_THRESHOLD=0.65
# Similarity at which two teams' initiatives are auto-flagged as a possible
# overlap after embedding. Defaults to AGENT_STRONG_MATCH_THRESHOLD.
OVERLAP_THRESHOLD=

# --- Admins ---
# Who is made an admin when they sign in, comma-separated. Nobody else is,
# so set this before the first sign-in. (A listed person is promoted again
# only if the install has no admin left.)
INITIAL_ADMIN_EMAILS=

# --- Teams ---
# The org units and countries a team can be filed under, comma-separated.
# People choose from these when they create a team, and the brief groups by
# org unit. Defaults (when blank) match the demo.
ORG_UNITS=Engineering,Marketing,Operations,Product,Security
COUNTRIES=DE,FR,NL,UK,US

# --- Notifications: weekly digest of new/changed initiatives ---
# Cron pattern for the schedule (default: Monday 09:00).
NOTIFICATIONS_CRON=0 9 * * 1
# "email" | "webhook" | unset (digest still builds each week, just isn't sent)
NOTIFICATIONS_CHANNEL=
# webhook channel — Slack/Matrix-compatible incoming webhook URL
NOTIFICATIONS_WEBHOOK_URL=
# "true" also posts real-time alerts (overlaps, new dependencies, status
# changes, comments) to NOTIFICATIONS_WEBHOOK_URL, not just the weekly digest.
NOTIFICATIONS_ALERTS=
# email channel
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=scry@localhost
NOTIFICATIONS_EMAIL_TO=
